@model TrialsViewModel
@using LeadPilot.Domain.Conversion
@{ ViewData["Title"] = "Trials"; var q = Model.Query; }
<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2"><h1 class="h3 mb-0">Trials</h1>@if (Model.CanManage) { <a class="btn btn-primary" asp-action="Create">New trial</a> }</div>
<form method="get" class="card card-body mb-3"><div class="row g-3 align-items-end"><div class="col-6 col-md-3"><label class="form-label" for="status">Status</label><select id="status" name="status" class="form-select"><option value="">All</option>@foreach (var d in Enum.GetValues<TrialStatus>()) { <option value="@d" selected="@(q.Status == d)">@d</option> }</select></div><div class="col-12 col-md-3"><button class="btn btn-outline-primary" type="submit">Filter</button> <a asp-action="Index" class="btn btn-link">Clear</a></div></div></form>
@if (Model.Result.Items.Count == 0) { <div class="card"><partial name="_EmptyState" model='("No trials", "Trials created by the team, the AI assistant or a workflow appear here.")' /></div> }
else
{
    <div class="card"><div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>Lead</th><th>Plan</th><th>Status</th><th>Ends (UTC)</th><th>Last activity</th><th></th></tr></thead><tbody>
    @foreach (var t in Model.Result.Items)
    {
        <tr><td><a asp-action="Details" asp-route-id="@t.Id" class="text-decoration-none">@t.LeadName</a></td><td>@(t.PlanName ?? "—")</td><td>@t.Status@if (t.ProvisioningRequiresStaff) { <span class="badge text-bg-warning ms-1">staff must provision</span> }</td><td class="small">@(t.ExpiresAtUtc?.ToString("yyyy-MM-dd HH:mm") ?? "—")</td><td class="small">@(t.LastActivityAtUtc?.ToString("yyyy-MM-dd") ?? "—")</td><td class="text-end"><a asp-action="Details" asp-route-id="@t.Id" class="btn btn-outline-primary btn-sm">Open</a></td></tr>
    }
    </tbody></table></div></div>
    <partial name="_Pager" model='new PagerModel(Model.Result.Page, Model.Result.TotalPages, Model.Result.TotalCount, "Index", Model.QueryValues)' />
}
