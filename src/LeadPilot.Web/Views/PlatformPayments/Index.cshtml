@model QueueViewModel
@using LeadPilot.Web.Models
@using LeadPilot.Domain.Billing
@{ ViewData["Title"] = Model.Queue ? "Payment verification" : "All invoices"; }
<h1 class="h3 mb-2">@ViewData["Title"]</h1>
@if (Model.Queue) { <p class="text-muted">Issued invoices waiting for money. Tenants that reported a transfer come first, but a report is only a hint: verify against your bank statement. Only a verified payment activates or renews a subscription.</p> }
else { <form method="get" class="mb-3 d-flex gap-2"><select name="status" class="form-select w-auto" aria-label="Status"><option value="">All</option>@foreach (var s in Enum.GetValues<InvoiceStatus>().Where(x => x != InvoiceStatus.Draft)) { <option value="@s" selected="@(Model.Status == s.ToString())">@s</option> }</select><button class="btn btn-outline-primary">Filter</button></form> }
@if (Model.Result.Items.Count == 0) { <div class="card"><partial name="_EmptyState" model='("Nothing here", Model.Queue ? "No invoice is waiting for payment." : "No invoices match.")' /></div> }
else
{
<div class="card"><div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>Invoice</th><th>Tenant</th><th class="text-end">Total</th><th>Due</th><th>Reported</th><th></th></tr></thead><tbody>
@foreach (var i in Model.Result.Items) { <tr><td>@i.Number<div class="small text-muted">@i.Kind</div></td><td>@i.TenantName</td><td class="text-end">@BillingFormat.Money(i.Total, i.Currency)</td><td>@i.DueAtUtc?.ToString("yyyy-MM-dd")</td><td>@if (i.ReportedEvidence is not null) { <span class="badge bg-info text-dark">@i.ReportedEvidence</span> }</td><td class="text-end"><a class="btn btn-outline-primary btn-sm" asp-action="Invoice" asp-route-forTenant="@i.TenantId" asp-route-id="@i.InvoiceId">Open</a></td></tr> }
</tbody></table></div></div>
<partial name="_Pager" model='new PagerModel(Model.Result.Page, Model.Result.TotalPages, Model.Result.TotalCount, Model.Queue ? "Index" : "Invoices", new Dictionary<string, string?> { ["status"] = Model.Status })' />
}
