@model ProfileFormModel
@{ ViewData["Title"] = "My profile"; }
<h1 class="h3 mb-3">My profile</h1>
<form asp-controller="Workspace" asp-action="Profile" method="post" data-loading-form novalidate class="card card-body">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
    <div class="row g-3">
        <div class="col-12 col-md-6 col-xl-3"><label class="form-label">E-mail</label><input class="form-control" value="@Model.Email" disabled /></div>
        <div class="col-12 col-md-6 col-xl-3"><label asp-for="DisplayName" class="form-label"></label><input asp-for="DisplayName" class="form-control" /><span asp-validation-for="DisplayName" class="text-danger small"></span></div>
        <div class="col-12 col-md-6 col-xl-3"><label asp-for="Phone" class="form-label"></label><input asp-for="Phone" class="form-control" /><span asp-validation-for="Phone" class="text-danger small"></span></div>
    </div>
    <div class="mt-3"><button type="submit" class="btn btn-primary"><span class="spinner-border spinner-border-sm d-none" aria-hidden="true"></span> Save</button></div>
</form>
