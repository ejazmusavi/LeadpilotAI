@model DiscoveryDetailsViewModel
@using LeadPilot.Domain.Discovery
@{
    var j = Model.Job; ViewData["Title"] = "Search · " + j.ConnectorName;
    var where = string.Join(", ", new[] { j.Area, j.District, j.City, j.Province, j.Country }.Where(x => !string.IsNullOrWhiteSpace(x)));
    var terminal = j.Status is DiscoveryJobStatus.Completed or DiscoveryJobStatus.Failed or DiscoveryJobStatus.Cancelled;
    string Badge(DiscoveryJobStatus s) => s switch { DiscoveryJobStatus.Completed => "text-bg-success", DiscoveryJobStatus.Failed => "text-bg-danger", DiscoveryJobStatus.Running => "text-bg-primary", DiscoveryJobStatus.Cancelled => "text-bg-secondary", _ => "text-bg-info" };
}
<div class="d-flex flex-wrap justify-content-between align-items-start mb-3 gap-2">
    <div><h1 class="h3 mb-1">@(j.CategoryName ?? j.Keywords ?? "Website search")@(string.IsNullOrEmpty(where) ? "" : " · " + where)</h1>
        <div class="text-muted">@j.ConnectorName · started by @(j.CreatedBy ?? "—") · @j.CreatedAtUtc.ToString("yyyy-MM-dd HH:mm") UTC</div></div>
    <div class="d-flex flex-wrap gap-2">
        <a asp-controller="DiscoveryResults" asp-action="Index" asp-route-jobId="@j.Id" class="btn btn-primary" id="results-link">Review results (<span id="pending-count">@j.PendingResults</span> pending)</a>
        @if (Model.CanRun)
        {
            @if (!terminal) { <form asp-action="Cancel" asp-route-id="@j.Id" method="post"><button type="submit" class="btn btn-outline-danger" data-confirm="Cancel this search? Results already found are kept." data-confirm-label="Cancel search">Cancel search</button></form> }
            @if (j.Status is DiscoveryJobStatus.Failed or DiscoveryJobStatus.Cancelled) { <form asp-action="Retry" asp-route-id="@j.Id" method="post"><button type="submit" class="btn btn-outline-primary">Retry</button></form> }
            <form asp-action="Rerun" asp-route-id="@j.Id" method="post"><button type="submit" class="btn btn-outline-secondary" data-confirm="Start a new search with the same settings? It counts against the monthly limit." data-confirm-label="Run again">Run again</button></form>
        }
    </div>
</div>
@if (j.Status == DiscoveryJobStatus.Failed)
{
    <div class="alert alert-danger" role="alert"><strong>The search failed</strong> (<code>@j.ErrorCode</code>): @j.ErrorMessage
        @if (j.ErrorRetryable) { <div class="small mt-1">This kind of failure can be retried. Retrying resumes where it stopped and never creates duplicate results.</div> }
        else { <div class="small mt-1">Fix the cause (for example the API key under Connectors &amp; usage), then retry.</div> }</div>
}
@if (j.CancelRequested && !terminal) { <div class="alert alert-warning" id="cancel-note">Cancellation requested: the search stops after the current page.</div> }
<div class="row g-3">
    <div class="col-12 col-lg-8"><div class="card"><div class="card-header d-flex justify-content-between"><span>Progress</span><span class="badge @Badge(j.Status)" id="job-status">@j.Status</span></div><div class="card-body">
        <div class="progress mb-3" role="progressbar" aria-label="Search progress" aria-valuenow="@j.Progress" aria-valuemin="0" aria-valuemax="100"><div class="progress-bar" id="job-bar" style="width:@(j.Progress)%">@j.Progress%</div></div>
        <dl class="row mb-0">
            <dt class="col-sm-4">Found</dt><dd class="col-sm-8"><span id="job-found">@j.ResultsFound</span> of up to @j.MaxResults</dd>
            <dt class="col-sm-4">New results</dt><dd class="col-sm-8" id="job-created">@j.ResultsNew</dd>
            <dt class="col-sm-4">Already known</dt><dd class="col-sm-8"><span id="job-known">@j.ResultsAlreadyKnown</span> <span class="small text-muted">(found by an earlier search; not duplicated)</span></dd>
            <dt class="col-sm-4">Possible duplicates</dt><dd class="col-sm-8"><span id="job-dups">@j.DuplicatesFlagged</span> <span class="small text-muted">(match leads already in the CRM)</span></dd>
            <dt class="col-sm-4">Pages / API calls</dt><dd class="col-sm-8"><span id="job-pages">@j.PagesFetched</span> / <span id="job-calls">@j.ApiCalls</span> · ≈ @j.EstimatedCostUsd.ToString("0.000") USD (estimate)</dd>
            <dt class="col-sm-4">Attempts</dt><dd class="col-sm-8">@j.Attempts</dd>
            @if (j.CompletedAtUtc is { } done) { <dt class="col-sm-4">Finished</dt><dd class="col-sm-8">@done.ToString("yyyy-MM-dd HH:mm") UTC</dd> }
        </dl></div></div></div>
    <div class="col-12 col-lg-4"><div class="card"><div class="card-header">Settings</div><div class="card-body small">
        <div><strong>Enrich websites:</strong> @(j.EnrichWebsites ? "yes" : "no")</div>
        @if (!string.IsNullOrWhiteSpace(j.Keywords)) { <div><strong>Keywords:</strong> @j.Keywords</div> }
        @if (!string.IsNullOrWhiteSpace(j.Warnings)) { <hr /><div class="fw-semibold">Notes from the run</div>@foreach (var w in j.Warnings.Split('\n')) { <div class="text-muted">@w</div> } }
    </div></div></div>
</div>
@section Scripts {
@if (!terminal)
{
<script>
(function () {
  var url = '@Url.Action("Status", new { id = j.Id })';
  function set(id, v) { var e = document.getElementById(id); if (e) e.textContent = v; }
  function tick() {
    fetch(url, { headers: { 'Accept': 'application/json' }, credentials: 'same-origin' }).then(function (r) { return r.ok ? r.json() : null; }).then(function (s) {
      if (!s) return;
      set('job-status', s.status); set('job-found', s.found); set('job-created', s.created); set('job-known', s.known); set('job-dups', s.duplicates); set('job-pages', s.pages); set('job-calls', s.calls); set('pending-count', s.pending);
      var bar = document.getElementById('job-bar'); if (bar) { bar.style.width = s.progress + '%'; bar.textContent = s.progress + '%'; }
      if (s.terminal) { window.location.reload(); } else { setTimeout(tick, 3000); }
    }).catch(function () { setTimeout(tick, 6000); });
  }
  setTimeout(tick, 2000);
})();
</script>
}
}
