# Copy to docker/.env (git-ignored) and change every value. Never commit real secrets.
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=leadpilot
MYSQL_USER=leadpilot
MYSQL_PASSWORD=change-me-app
ASPNETCORE_ENVIRONMENT=Production
# Only the "web" service applies migrations. Set to false and run a migration step in production if preferred.
MIGRATE_ON_STARTUP=true
# First administrator (created only when no users exist). Remove after first start.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SWAGGER_ENABLED=true
# REQUIRED: >= 32 random characters used to sign API access tokens (the api container refuses to start without it).
JWT_SIGNING_KEY=
# Public URL of the dashboard, used for links in invitation e-mails.
PUBLIC_WEB_URL=http://localhost:8080
