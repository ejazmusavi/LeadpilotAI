@model IReadOnlyList<RoleDto>
@{ ViewData["Title"] = "Roles & permissions"; }
<div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
    <h1 class="h3 mb-0">Roles &amp; permissions</h1>
    <a asp-action="Create" class="btn btn-primary">New role</a>
</div>
<div class="card"><div class="table-responsive"><table class="table align-middle mb-0">
    <thead><tr><th>Role</th><th class="text-end">Permissions</th><th class="text-end">Users</th><th></th></tr></thead>
    <tbody>
    @foreach (var r in Model)
    {
        <tr>
            <td><div class="fw-semibold">@r.Name @if (r.IsSystem) { <span class="badge text-bg-light">system</span> }</div><div class="text-muted small">@r.Description</div></td>
            <td class="text-end">@r.PermissionCount</td><td class="text-end">@r.UserCount</td>
            <td class="text-end table-actions">
                <a asp-action="Edit" asp-route-id="@r.Id" class="btn btn-sm btn-outline-secondary">@(r.IsSystem ? "View" : "Edit")</a>
                @if (!r.IsSystem)
                {
                    <form asp-action="Delete" asp-route-id="@r.Id" method="post"><button type="submit" class="btn btn-sm btn-outline-danger" data-confirm="Delete the role '@r.Name'? This cannot be undone." data-confirm-label="Delete">Delete</button></form>
                }
            </td>
        </tr>
    }
    </tbody></table></div></div>
