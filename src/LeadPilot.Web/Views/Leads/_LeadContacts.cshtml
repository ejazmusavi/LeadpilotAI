@model LeadDetailsViewModel
@using LeadPilot.Domain.Crm
@{ var l = Model.Lead; var can = Model.Can; }
@if (Model.Contacts.Count == 0)
{
    <div class="card mb-3"><partial name="_EmptyState" model='("No contacts yet", can.Update && !l.IsArchived ? "Add the people you can reach at this organization." : "Nobody has added a contact to this lead.")' /></div>
}
else
{
    <div class="card mb-3"><div class="table-responsive"><table class="table align-middle mb-0">
        <thead><tr><th>Contact</th><th>Phone</th><th>E-mail</th><th>Origin</th><th>Consent</th><th></th></tr></thead>
        <tbody>
        @foreach (var c in Model.Contacts)
        {
            <tr>
                <td><div class="fw-semibold">@(c.Name ?? "—") @if (c.IsPrimary) { <span class="badge text-bg-primary">primary</span> }</div><div class="small text-muted">@c.Role</div></td>
                <td>@(c.Phone ?? "—")@if (c.PhoneVerifiedAtUtc is not null) { <span class="badge text-bg-success ms-1" title="Verified @c.PhoneVerifiedAtUtc.Value.ToString("yyyy-MM-dd")">verified</span> }</td>
                <td>@(c.Email ?? "—")</td>
                <td><span class="badge text-bg-light border">@c.DataOrigin</span></td>
                <td>@if (c.Consent.Count == 0) { <span class="text-muted small">none recorded</span> } else { foreach (var s in c.Consent) { <span class="badge @(s.Status == ConsentStatus.Granted ? "text-bg-success" : "text-bg-danger") me-1" title="@s.Source, @s.OccurredAtUtc.ToString("yyyy-MM-dd")">@s.Channel/@s.Purpose: @s.Status</span> } }</td>
                <td class="text-end table-actions">
                    @if (can.Update && !l.IsArchived)
                    {
                        <a asp-action="EditContact" asp-route-id="@l.Id" asp-route-contactId="@c.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                        <form asp-action="RemoveContact" asp-route-id="@l.Id" asp-route-contactId="@c.Id" method="post"><button type="submit" class="btn btn-sm btn-outline-danger" data-confirm="Remove this contact? Its consent history is kept." data-confirm-label="Remove">Remove</button></form>
                    }
                </td>
            </tr>
        }
        </tbody></table></div></div>
}
@if (can.Update && !l.IsArchived)
{
    <form asp-action="AddContact" asp-route-id="@l.Id" method="post" data-loading-form novalidate class="card card-body">
        <h2 class="h6">Add a contact</h2>
        <div class="row g-3">
            <div class="col-12 col-md-6 col-xl-3"><label asp-for="ContactForm.Name" class="form-label"></label><input asp-for="ContactForm.Name" class="form-control" /></div>
            <div class="col-12 col-md-6 col-xl-3"><label asp-for="ContactForm.Role" class="form-label"></label><input asp-for="ContactForm.Role" class="form-control" /></div>
            <div class="col-12 col-md-6 col-xl-3"><label asp-for="ContactForm.Phone" class="form-label"></label><input asp-for="ContactForm.Phone" class="form-control" placeholder="+966 50 123 4567" /></div>
            <div class="col-12 col-md-6 col-xl-3"><label asp-for="ContactForm.Email" class="form-label"></label><input asp-for="ContactForm.Email" class="form-control" /></div>
            <div class="col-12 col-md-6 col-xl-3"><label asp-for="ContactForm.DataOrigin" class="form-label"></label><select asp-for="ContactForm.DataOrigin" class="form-select" asp-items="Html.GetEnumSelectList<DataOrigin>()"></select></div>
            <div class="col-12 col-md-6 col-xl-3 d-flex align-items-end"><div class="form-check"><input asp-for="ContactForm.IsPrimary" class="form-check-input" /><label asp-for="ContactForm.IsPrimary" class="form-check-label"></label></div></div>
        </div>
        <div class="form-text mt-2">A contact needs a name, a phone number or an e-mail address. Phone numbers are stored in international (E.164) format.</div>
        <div class="mt-3"><button type="submit" class="btn btn-primary"><span class="spinner-border spinner-border-sm d-none" aria-hidden="true"></span> Add contact</button></div>
    </form>
}
