@model CredentialsFormModel
@using LeadPilot.Application.Messaging
@{ var acc = (ChannelAccountDto)ViewData["Account"]!; ViewData["Title"] = "Credentials · " + acc.DisplayName; }
<h1 class="h3 mb-1">Replace credentials</h1>
<p class="text-muted">@acc.DisplayName · session <code>@acc.GatewayAccountId</code>. Current key: <code>@acc.KeyHint</code>. Stored values are never shown again.</p>
<div class="row"><div class="col-12 col-lg-8">
<form method="post" data-loading-form novalidate class="card card-body">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="mb-3"><label asp-for="BaseUrl" class="form-label"></label><input asp-for="BaseUrl" class="form-control" required /><span asp-validation-for="BaseUrl" class="text-danger"></span></div>
    <div class="mb-3"><label asp-for="ApiKey" class="form-label"></label><input asp-for="ApiKey" class="form-control" type="password" autocomplete="off" required /><span asp-validation-for="ApiKey" class="text-danger"></span></div>
    <div class="mb-3"><label asp-for="WebhookSecret" class="form-label"></label><input asp-for="WebhookSecret" class="form-control" type="password" autocomplete="off" /></div>
    <div class="d-flex gap-2"><button type="submit" class="btn btn-primary"><span class="spinner-border spinner-border-sm d-none" aria-hidden="true"></span> Test and save</button><a asp-action="Details" asp-route-id="@acc.Id" class="btn btn-link">Cancel</a></div>
</form></div></div>
