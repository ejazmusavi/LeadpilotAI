@model ConvertViewModel
@using LeadPilot.Domain.Conversion
@{ ViewData["Title"] = "Convert to customer"; }
<h1 class="h3 mb-1">Convert to customer</h1>
<p class="text-muted">@Model.LeadName · opportunity “@Model.OpportunityName” (@Model.OpportunityValue.ToString("0.00") @Model.OpportunityCurrency). The lead's history stays linked. The subscription is created <strong>pending</strong> and only a verified payment activates it. You are recorded as the person who approved these terms.</p>
<form asp-action="Convert" method="post" class="card card-body"><input type="hidden" asp-for="OpportunityId" />
    <div class="row g-3">
        <div class="col-md-6"><label class="form-label" asp-for="PlanId">Plan (product catalog)</label><select asp-for="PlanId" class="form-select" required><option value="">— choose —</option>@foreach (var p in Model.Plans) { <option value="@p.Id">@p.Label</option> }</select></div>
        <div class="col-md-3"><label class="form-label" asp-for="BillingCycle">Billing cycle</label><select asp-for="BillingCycle" class="form-select">@foreach (var b in Enum.GetValues<BillingCycle>()) { <option value="@b">@b</option> }</select></div>
        <div class="col-6 col-md-2"><label class="form-label" asp-for="Price">Agreed price (blank = plan price)</label><input asp-for="Price" class="form-control" /></div>
        <div class="col-6 col-md-1"><label class="form-label" asp-for="Currency">Cur.</label><input asp-for="Currency" class="form-control" maxlength="3" /></div>
        @if (Model.Trials.Count > 0) { <div class="col-md-6"><label class="form-label" asp-for="TrialId">Trial that is being converted</label><select asp-for="TrialId" class="form-select"><option value="">— none —</option>@foreach (var t in Model.Trials) { <option value="@t.Id">@(t.PlanName ?? "Trial") · @t.Status</option> }</select></div> }
        <div class="col-12"><label class="form-label" asp-for="Terms">Commercial terms that were agreed</label><textarea asp-for="Terms" class="form-control" rows="4" required></textarea></div>
    </div>
    <div class="mt-3"><button class="btn btn-success" type="submit" data-confirm="Record these terms as approved by you and create the customer with a pending subscription?" data-confirm-label="Convert">Convert</button> <a class="btn btn-link" asp-action="Index">Cancel</a></div></form>
