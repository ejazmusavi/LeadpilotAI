@{ Layout = "_AuthLayout"; ViewData["Title"] = "No workspace"; }
<h2 class="h5">No active workspace</h2>
<p class="text-muted">Your account is not a member of an active workspace. Ask a workspace administrator to invite you, or contact support if your workspace was suspended.</p>
<form asp-controller="Account" asp-action="Logout" method="post"><button type="submit" class="btn btn-outline-secondary w-100">Sign out</button></form>
