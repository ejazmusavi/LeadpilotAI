@model LeadFormModel
@using LeadPilot.Domain.Crm
@{
    var edit = Model.Id is not null;
    ViewData["Title"] = edit ? "Edit lead" : "New lead";
    var lk = Model.Lookups;
}
<h1 class="h3 mb-3">@(edit ? "Edit lead" : "New lead")</h1>
<form asp-action="@(edit ? "Edit" : "Create")" asp-route-id="@Model.Id" method="post" data-loading-form novalidate class="card card-body">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
    @if (Model.ShowDuplicateOverride)
    {
        <div class="alert alert-warning">
            This looks like a lead you already have. Check the existing lead first.
            <div class="form-check mt-2"><input asp-for="AllowDuplicate" class="form-check-input" /><label asp-for="AllowDuplicate" class="form-check-label">Create it anyway (it really is a different organization)</label></div>
        </div>
    }
    @if (edit) { <input type="hidden" asp-for="Version" /> }
    <h2 class="h6">Organization</h2>
    <div class="row g-3 mb-3">
        <div class="col-12 col-md-6 col-xl-6"><label asp-for="Name" class="form-label"></label><input asp-for="Name" class="form-control" required /><span asp-validation-for="Name" class="text-danger small"></span></div>
        <div class="col-12 col-md-6 col-xl-3"><label asp-for="CategoryId" class="form-label"></label>
            <select asp-for="CategoryId" class="form-select"><option value="">—</option>@foreach (var c in lk.Categories) { <option value="@c.Id" selected="@(Model.CategoryId == c.Id)">@c.Name</option> }</select></div>
        <div class="col-12 col-md-6 col-xl-3"><label asp-for="Website" class="form-label"></label><input asp-for="Website" class="form-control" placeholder="https://example.com" /><span asp-validation-for="Website" class="text-danger small"></span></div>
        <div class="col-12 col-md-6 col-xl-3"><label asp-for="Country" class="form-label"></label><input asp-for="Country" class="form-control" /></div>
        <div class="col-12 col-md-6 col-xl-3"><label asp-for="Province" class="form-label"></label><input asp-for="Province" class="form-control" /></div>
        <div class="col-12 col-md-6 col-xl-3"><label asp-for="City" class="form-label"></label><input asp-for="City" class="form-control" /></div>
        <div class="col-12 col-md-6 col-xl-3"><label asp-for="District" class="form-label"></label><input asp-for="District" class="form-control" /></div>
        <div class="col-12 col-md-6 col-xl-3"><label asp-for="Area" class="form-label"></label><input asp-for="Area" class="form-control" /></div>
        <div class="col-12 col-md-6 col-xl-6"><label asp-for="Address" class="form-label"></label><input asp-for="Address" class="form-control" /></div>
        <div class="col-12 col-md-6 col-xl-3"><label asp-for="Confidence" class="form-label"></label><input asp-for="Confidence" type="number" min="0" max="100" class="form-control" /><span asp-validation-for="Confidence" class="text-danger small"></span></div>
        @if (edit)
        {
            <div class="col-12 col-md-6 col-xl-3"><label asp-for="StatusId" class="form-label"></label>
                <select asp-for="StatusId" class="form-select">@foreach (var s in lk.Statuses) { <option value="@s.Id" selected="@(Model.StatusId == s.Id)">@s.Name</option> }</select></div>
        }
        else
        {
            <div class="col-12 col-md-6 col-xl-3"><label asp-for="StageId" class="form-label"></label>
                <select asp-for="StageId" class="form-select"><option value="">Default (first stage)</option>@if (lk.DefaultPipeline is { } dp) { foreach (var s in dp.Stages) { <option value="@s.Id" selected="@(Model.StageId == s.Id)">@s.Name</option> } }</select></div>
            @if (Model.CanAssign)
            {
                <div class="col-12 col-md-6 col-xl-3"><label asp-for="OwnerUserId" class="form-label"></label>
                    <select asp-for="OwnerUserId" class="form-select"><option value="">Unassigned</option>@foreach (var o in lk.Owners) { <option value="@o.UserId" selected="@(Model.OwnerUserId == o.UserId)">@o.DisplayName</option> }</select></div>
            }
            <div class="col-12 col-md-6 col-xl-3"><label asp-for="SourceName" class="form-label"></label><input asp-for="SourceName" class="form-control" placeholder="e.g. Trade fair 2026" /></div>
        }
    </div>
    @if (!edit)
    {
        <h2 class="h6">First contact (optional)</h2>
        <div class="row g-3 mb-3">
            <div class="col-12 col-md-6 col-xl-3"><label asp-for="ContactName" class="form-label"></label><input asp-for="ContactName" class="form-control" /></div>
            <div class="col-12 col-md-6 col-xl-3"><label asp-for="ContactRole" class="form-label"></label><input asp-for="ContactRole" class="form-control" /></div>
            <div class="col-12 col-md-6 col-xl-3"><label asp-for="ContactPhone" class="form-label"></label><input asp-for="ContactPhone" class="form-control" placeholder="+966 50 123 4567" /></div>
            <div class="col-12 col-md-6 col-xl-3"><label asp-for="ContactEmail" class="form-label"></label><input asp-for="ContactEmail" class="form-control" /></div>
        </div>
        <div class="form-text mb-3">Adding a contact does not give you permission to message them. Consent is recorded separately on the lead's Consent tab.</div>
    }
    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-primary"><span class="spinner-border spinner-border-sm d-none" aria-hidden="true"></span> @(edit ? "Save changes" : "Create lead")</button>
        <a href="@(edit ? Url.Action("Details", new { id = Model.Id }) : Url.Action("Index"))" class="btn btn-outline-secondary">Cancel</a>
    </div>
</form>
