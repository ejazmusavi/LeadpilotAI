@model WorkflowBuilderViewModel
@using LeadPilot.Web.Models
@{ ViewData["Title"] = Model.Id is null ? "New workflow" : "Edit draft"; }
<div class="mb-3"><h1 class="h3 mb-1">@(Model.Id is null ? "New workflow" : $"Edit draft v{Model.VersionNumber}")</h1>
    <p class="text-muted mb-0">@(Model.ActiveExists ? "You are editing a new draft. The active version keeps running unchanged until you activate this one." : "Saving creates a draft. Nothing runs until you activate it.")</p></div>
@if (!ViewData.ModelState.IsValid) { <div class="alert alert-danger" role="alert"><div asp-validation-summary="All"></div></div> }
<form id="wf-form" asp-action="Save" method="post" novalidate>
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="DefinitionJson" id="wf-definition" />
    <div class="card mb-3"><div class="card-body row g-3">
        <div class="col-12 col-md-5"><label class="form-label" asp-for="Name">Name</label><input asp-for="Name" class="form-control" maxlength="150" required /><span asp-validation-for="Name" class="text-danger small"></span></div>
        <div class="col-12 col-md-7"><label class="form-label" asp-for="Description">Description (optional)</label><input asp-for="Description" class="form-control" maxlength="1000" /></div>
    </div></div>

    <div id="wf-builder" aria-live="polite"><noscript><div class="alert alert-warning">The workflow builder needs JavaScript.</div></noscript></div>

    <div id="wf-problems" class="mt-3" role="status"></div>
    <div class="d-flex flex-wrap gap-2 mt-3 mb-5">
        <button type="submit" class="btn btn-primary">Save draft</button>
        <button type="button" class="btn btn-outline-secondary" id="wf-check">Check workflow</button>
        <a class="btn btn-link" href="@(Model.Id is null ? Url.Action("Index") : Url.Action("Details", new { id = Model.Id }))">Cancel</a>
    </div>
</form>
<script type="application/json" id="wf-catalog">@Html.Raw(WorkflowJson.ForScript(Model.Catalog))</script>
<script type="application/json" id="wf-initial">@Html.Raw(string.IsNullOrWhiteSpace(Model.DefinitionJson) ? "null" : Model.DefinitionJson)</script>
@section Scripts { <script src="~/js/workflow-builder.js" asp-append-version="true"></script> }
