@model ReportsIndexViewModel
@{ ViewData["Title"] = "Reports"; }
<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3"><h1 class="h3 mb-0">Reports</h1><a asp-action="Metrics" class="btn btn-outline-secondary btn-sm">Metric definitions</a></div>
@if (!Model.Team) { <div class="alert alert-info">You see reports about your own leads and work. Workspace-wide reports need the Reports.Team permission.</div> }
<div class="row g-3">
@foreach (var r in Model.Reports)
{
    <div class="col-12 col-md-6 col-xl-4"><div class="card h-100"><div class="card-body d-flex flex-column">
        <h2 class="h6">@r.Title</h2><p class="small text-muted flex-grow-1">@r.Description</p>
        <div><a asp-action="Show" asp-route-key="@r.Key" class="btn btn-primary btn-sm">Open</a></div>
    </div></div></div>
}
</div>
