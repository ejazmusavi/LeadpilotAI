@model TemplateFormModel
@using LeadPilot.Domain.Messaging
@{ ViewData["Title"] = Model.Id is null ? "New template" : "Edit template"; }
<h1 class="h3 mb-3">@ViewData["Title"]</h1>
<div class="row"><div class="col-12 col-lg-8">
<form asp-action="Save" method="post" data-loading-form novalidate class="card card-body">
    <input type="hidden" asp-for="Id" />
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="mb-3"><label asp-for="Name" class="form-label"></label><input asp-for="Name" class="form-control" required /><span asp-validation-for="Name" class="text-danger"></span></div>
    <div class="mb-3"><label asp-for="Category" class="form-label"></label><select asp-for="Category" class="form-select" asp-items="Html.GetEnumSelectList<TemplateCategory>()"></select></div>
    <div class="mb-3"><label asp-for="Body" class="form-label">Text</label><textarea asp-for="Body" class="form-control" rows="6" required></textarea><div class="form-text">Placeholders: @string.Join(", ", LeadPilot.Application.Messaging.TemplateRenderer.KnownVariables.Select(v => "{{" + v + "}}")).</div><span asp-validation-for="Body" class="text-danger"></span></div>
    <div class="d-flex gap-2"><button type="submit" class="btn btn-primary"><span class="spinner-border spinner-border-sm d-none" aria-hidden="true"></span> Save</button><a asp-action="Index" class="btn btn-link">Cancel</a></div>
</form></div></div>
