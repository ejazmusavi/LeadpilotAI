@model TagsViewModel
@{ ViewData["Title"] = "Tags"; }
<h1 class="h3 mb-3">Tags</h1>
@if (Model.CanUpdate)
{
    <form asp-action="Create" method="post" data-loading-form class="card card-body mb-3">
        <div class="row g-3 align-items-end">
            <div class="col-12 col-md-6 col-xl-4"><label class="form-label" for="tag-new">New tag</label><input id="tag-new" name="name" class="form-control" maxlength="50" required /></div>
            <div class="col-12 col-md-6 col-xl-3"><button type="submit" class="btn btn-primary"><span class="spinner-border spinner-border-sm d-none" aria-hidden="true"></span> Create tag</button></div>
        </div>
    </form>
}
@if (Model.Tags.Count == 0)
{
    <div class="card"><partial name="_EmptyState" model='("No tags yet", "Tags label leads so you can filter and bulk-edit them.")' /></div>
}
else
{
    <div class="card"><div class="table-responsive"><table class="table align-middle mb-0">
        <thead><tr><th>Tag</th><th>Leads</th><th></th></tr></thead>
        <tbody>
        @foreach (var t in Model.Tags)
        {
            <tr>
                <td>@if (Model.CanUpdate) { <form asp-action="Rename" asp-route-id="@t.Id" method="post" class="d-flex gap-1"><input name="name" value="@t.Name" class="form-control form-control-sm" aria-label="Tag name" maxlength="50" required /><button type="submit" class="btn btn-sm btn-outline-secondary">Rename</button></form> } else { <span>@t.Name</span> }</td>
                <td><a asp-controller="Leads" asp-action="Index" asp-route-tagId="@t.Id">@t.LeadCount</a></td>
                <td class="text-end">@if (Model.CanDelete) { <form asp-action="Delete" asp-route-id="@t.Id" method="post"><button type="submit" class="btn btn-sm btn-outline-danger" data-confirm="Delete the tag @t.Name? It is removed from @t.LeadCount lead(s)." data-confirm-label="Delete">Delete</button></form> }</td>
            </tr>
        }
        </tbody></table></div></div>
}
