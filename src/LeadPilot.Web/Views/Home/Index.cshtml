@model DashboardViewModel
@using LeadPilot.Application.Analytics
@{
    ViewData["Title"] = "Dashboard";
    var d = Model.Dashboard;
}
<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h1 class="h3 mb-0">Dashboard</h1>
    @if (d is not null) { <span class="badge text-bg-secondary">@(d.Scope == "Team" ? "Workspace view" : "Your own leads")</span> }
</div>

@if (d is null)
{
    <div class="card mb-3"><div class="card-body">
        @if (Model.Error is not null) { <div class="alert alert-warning mb-0" role="alert">@Model.Error</div> }
        else { <partial name="_EmptyState" model='("The dashboard needs the Dashboard.View permission", "Ask a workspace administrator to grant it. Nothing on this page is sample data.")' /> }
    </div></div>
}
else
{
    <partial name="_RangeFilter" model='new RangeFilterModel("Home", "Index", Model.Request, d.Range, new Dictionary<string, string?>(), true)' />
    <div class="d-flex flex-wrap gap-2 align-items-center mb-3 small" id="freshness">
        <span class="badge @(d.Freshness.Stale ? "text-bg-warning" : "text-bg-light border")">@d.Freshness.Source</span>
        <span>Data as of <strong>@d.Freshness.AsOfUtc.ToString("yyyy-MM-dd HH:mm") UTC</strong>@(d.Freshness.Stale ? " — the background refresh is late" : "")</span>
        <span class="text-muted">@d.Freshness.Note</span>
    </div>
    <div class="d-flex flex-wrap gap-2 mb-3 small" aria-label="Label legend">
        <span><span class="badge text-bg-success">Verified</span> counted from recorded facts</span>
        <span><span class="badge text-bg-primary">Calculated</span> derived by a stated formula</span>
        <span><span class="badge text-bg-warning">Estimated</span> rests on an assumption</span>
        <a asp-controller="Reports" asp-action="Metrics">All definitions</a>
    </div>
    <div class="row g-3 mb-3">
        @foreach (var m in d.Metrics) { <partial name="_MetricCard" model="m" /> }
    </div>
    <h2 class="h5">Trends</h2>
    <div class="row g-3 mb-4">
        @foreach (var t in d.Trends) { <div class="col-12 col-md-6 col-xl-4"><partial name="_Trend" model="t" /></div> }
    </div>
    @if (d.Metrics.All(m => !m.Available || (m.Value ?? 0) == 0 && (m.Money is null || m.Money.Count == 0)))
    {
        <div class="card mb-3"><partial name="_EmptyState" model='("No recorded activity yet", "Every figure above is zero or empty because no matching records exist in this workspace for the selected period. Nothing here is sample data.")' /></div>
    }
}

<div class="row g-3">
    <div class="col-12 col-md-6 col-xl-4">
        <div class="card h-100">
            <div class="card-header">System status</div>
            <ul class="list-group list-group-flush">
                <li class="list-group-item d-flex justify-content-between"><span>Database</span>
                    <span class="badge @(Model.DatabaseHealthy ? "text-bg-success" : "text-bg-danger")">@(Model.DatabaseHealthy ? "Connected" : "Unavailable")</span></li>
                <li class="list-group-item d-flex justify-content-between"><span>Environment</span><span>@Model.Environment</span></li>
                <li class="list-group-item d-flex justify-content-between"><span>Version</span><span>@Model.Version</span></li>
            </ul>
        </div>
    </div>
</div>
