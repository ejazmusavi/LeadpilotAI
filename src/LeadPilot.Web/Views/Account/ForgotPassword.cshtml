@model ForgotPasswordViewModel
@{ Layout = "_AuthLayout"; ViewData["Title"] = "Forgot password"; }
<h2 class="h5">Reset your password</h2>
<p class="text-muted small">Enter your email and we will send you a reset link if an account exists.</p>
<form asp-action="ForgotPassword" method="post" data-loading-form novalidate>
    <div class="mb-3"><label asp-for="Email" class="form-label"></label><input asp-for="Email" type="email" class="form-control" autocomplete="username" autofocus /><span asp-validation-for="Email" class="text-danger small"></span></div>
    <button type="submit" class="btn btn-primary w-100"><span class="spinner-border spinner-border-sm d-none" aria-hidden="true"></span> Send reset link</button>
    <p class="mt-3 small text-center"><a asp-action="Login">Back to sign in</a></p>
</form>
