@model PlatformPlanForm
@using LeadPilot.Application.Billing
@using LeadPilot.Domain.Billing
@{ ViewData["Title"] = Model.Id is null ? "New plan" : "Edit plan"; }
<h1 class="h3 mb-3">@ViewData["Title"]</h1>
<form asp-action="Save" method="post" novalidate>
<input type="hidden" asp-for="Id" />
<div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
<div class="card mb-3"><div class="card-header">Plan</div><div class="card-body"><div class="row g-3">
    <div class="col-md-4"><label asp-for="Code" class="form-label"></label><input asp-for="Code" class="form-control" readonly="@(Model.Id is not null)" /><span asp-validation-for="Code" class="text-danger small"></span></div>
    <div class="col-md-8"><label asp-for="Name" class="form-label"></label><input asp-for="Name" class="form-control" /><span asp-validation-for="Name" class="text-danger small"></span></div>
    <div class="col-12"><label asp-for="Description" class="form-label"></label><textarea asp-for="Description" class="form-control" rows="2"></textarea></div>
    <div class="col-md-3"><label asp-for="Price" class="form-label"></label><input asp-for="Price" type="number" step="0.01" min="0" class="form-control" /></div>
    <div class="col-md-2"><label asp-for="Currency" class="form-label"></label><input asp-for="Currency" class="form-control" maxlength="3" /></div>
    <div class="col-md-3"><label asp-for="Cycle" class="form-label">Billing cycle</label><select asp-for="Cycle" asp-items="Html.GetEnumSelectList<PlanCycle>()" class="form-select"></select></div>
    <div class="col-md-4"><label asp-for="CustomPeriodDays" class="form-label">Custom cycle length (days)</label><input asp-for="CustomPeriodDays" type="number" min="1" class="form-control" /></div>
    <div class="col-md-3"><label asp-for="Visibility" class="form-label"></label><select asp-for="Visibility" asp-items="Html.GetEnumSelectList<PlanVisibility>()" class="form-select"></select></div>
    <div class="col-md-3"><label asp-for="SortOrder" class="form-label"></label><input asp-for="SortOrder" type="number" class="form-control" /></div>
    <div class="col-md-3 pt-4"><div class="form-check"><input asp-for="IsTrial" class="form-check-input" /><label asp-for="IsTrial" class="form-check-label">Trial plan (price must be 0)</label></div></div>
    <div class="col-md-3"><label asp-for="TrialDays" class="form-label">Trial duration (days)</label><input asp-for="TrialDays" type="number" min="1" class="form-control" /></div>
</div></div></div>
<div class="card mb-3"><div class="card-header">Limits <span class="small text-muted">(empty = unlimited, 0 = not included; period limits reset with the subscription period)</span></div><div class="card-body"><div class="row g-3">
@foreach (var d in DimensionCatalog.All) { var v = Model.Limits.TryGetValue(d.Dimension, out var x) ? x : null; <div class="col-md-4"><label class="form-label" for="lim-@d.Dimension">@d.Label (@d.Unit)</label><input id="lim-@d.Dimension" name="Limits[@d.Dimension]" type="number" min="0" class="form-control" value="@v" /><div class="form-text">@d.Source</div></div> }
</div></div></div>
<div class="card mb-3"><div class="card-header">Features</div><div class="card-body">
@foreach (var f in Features.All) { <div class="form-check"><input id="feat-@f.Key" name="Features" type="checkbox" value="@f.Key" class="form-check-input" checked="@(Model.Features.Contains(f.Key))" /><label class="form-check-label" for="feat-@f.Key">@f.Label <span class="text-muted small">— @f.Description</span></label></div> }
</div></div>
<button class="btn btn-primary">Save plan</button> <a class="btn btn-link" asp-action="Index">Cancel</a>
</form>
