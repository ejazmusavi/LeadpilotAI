@model TenantFormModel
@{ ViewData["Title"] = "New tenant"; }
<h1 class="h3 mb-3">New tenant</h1>
<form asp-action="Create" method="post" data-loading-form novalidate class="card card-body">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
    <div class="row g-3">
        <div class="col-12 col-md-6 col-xl-3"><label asp-for="Name" class="form-label"></label><input asp-for="Name" class="form-control" /><span asp-validation-for="Name" class="text-danger small"></span></div>
        <div class="col-12 col-md-6 col-xl-3"><label asp-for="Slug" class="form-label"></label><input asp-for="Slug" class="form-control" /><div class="form-text">Lowercase letters, digits, hyphens. Derived from the name when empty.</div><span asp-validation-for="Slug" class="text-danger small"></span></div>
        <div class="col-12 col-md-6 col-xl-3"><label asp-for="Industry" class="form-label"></label><input asp-for="Industry" class="form-control" /></div>
        <div class="col-12 col-md-6 col-xl-3"><label asp-for="Timezone" class="form-label"></label><input asp-for="Timezone" class="form-control" /><div class="form-text">IANA name, e.g. Asia/Karachi.</div><span asp-validation-for="Timezone" class="text-danger small"></span></div>
        <div class="col-12 col-md-6 col-xl-3"><label asp-for="Locale" class="form-label"></label><input asp-for="Locale" class="form-control" /></div>
        <div class="col-12 col-md-6 col-xl-3"><label asp-for="AdminEmail" class="form-label"></label><input asp-for="AdminEmail" type="email" class="form-control" /><div class="form-text">They receive an invitation as Tenant Administrator.</div><span asp-validation-for="AdminEmail" class="text-danger small"></span></div>
    </div>
    <div class="mt-3 d-flex gap-2"><button type="submit" class="btn btn-primary"><span class="spinner-border spinner-border-sm d-none" aria-hidden="true"></span> Create tenant</button><a asp-action="Index" class="btn btn-outline-secondary">Cancel</a></div>
</form>
