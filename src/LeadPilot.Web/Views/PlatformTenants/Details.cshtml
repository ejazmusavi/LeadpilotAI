@model PlatformTenantViewModel
@using LeadPilot.Web.Models
@using LeadPilot.Application.Billing
@using LeadPilot.Domain.Tenancy
@{ var d = Model.Detail; var r = d.Row; ViewData["Title"] = r.Name; }
<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3"><h1 class="h3 mb-0">@r.Name <span class="badge @(r.Status == TenantStatus.Active ? "bg-success" : "bg-danger")">@r.Status</span></h1><a class="btn btn-outline-secondary" asp-controller="Tenants" asp-action="Details" asp-route-id="@r.Id">Tenant profile</a></div>
@if (r.Status == TenantStatus.Suspended) { <div class="alert alert-danger">Suspended (@r.SuspensionKind): @d.SuspensionReason <form asp-action="Reactivate" asp-route-id="@r.Id" method="post" class="d-inline ms-2"><button class="btn btn-sm btn-success">Reactivate</button></form></div> }
@if (d.Entitlements.Subscription is { } sub) { <div class="card mb-3"><div class="card-body"><strong>@sub.PlanName</strong> <span class="badge @BillingFormat.StateBadge(sub.State)">@sub.State</span> · period @sub.PeriodStartUtc.ToString("yyyy-MM-dd") → @sub.PeriodEndUtc.ToString("yyyy-MM-dd") @if (sub.GraceEndsAtUtc is not null) { <span class="text-warning"> · grace until @sub.GraceEndsAtUtc.Value.ToString("yyyy-MM-dd")</span> } @if (sub.GrantReason is not null) { <div class="small text-muted">Granted: @sub.GrantReason</div> }</div></div> }
<div class="row g-3">
<div class="col-lg-7"><partial name="_UsageBars" model="d.Entitlements" />
<div class="card mb-3"><div class="card-header">Overrides</div>
@if (d.Overrides.Count == 0) { <div class="card-body text-muted">None: the plan applies.</div> }
else { <ul class="list-group list-group-flush">@foreach (var o in d.Overrides) { <li class="list-group-item d-flex justify-content-between align-items-start gap-2"><div><strong>@o.Key</strong>: @(o.Kind == LeadPilot.Domain.Billing.OverrideKind.Feature ? (o.FeatureEnabled == true ? "on" : "off") : o.Unlimited ? "unlimited" : o.LimitValue?.ToString()) @if (o.ExpiresAtUtc is not null) { <span class="small text-muted">until @o.ExpiresAtUtc.Value.ToString("yyyy-MM-dd")</span> }<div class="small text-muted">@o.Reason</div></div><form asp-action="RemoveOverride" asp-route-id="@r.Id" method="post"><input type="hidden" name="key" value="@o.Key" /><button class="btn btn-outline-danger btn-sm">Remove</button></form></li> }</ul> }</div>
<div class="card"><div class="card-header">History</div><ul class="list-group list-group-flush">@foreach (var e in d.Events) { <li class="list-group-item small"><span class="text-muted">@e.OccurredAtUtc.ToString("yyyy-MM-dd HH:mm")</span> <strong>@e.Type</strong> @e.Summary</li> }</ul></div></div>
<div class="col-lg-5">
<div class="card mb-3"><div class="card-header">Grant a plan (no payment)</div><div class="card-body"><form asp-action="Grant" asp-route-id="@r.Id" method="post"><div class="mb-2"><label class="form-label" for="g-plan">Plan</label><select id="g-plan" name="PlanId" class="form-select">@foreach (var p in Model.Plans) { <option value="@p.Id">@p.Name</option> }</select></div><div class="mb-2"><label class="form-label" for="g-end">Until (optional)</label><input id="g-end" name="PeriodEnd" type="date" class="form-control" /></div><div class="mb-2"><label class="form-label" for="g-reason">Reason (audited)</label><input id="g-reason" name="Reason" class="form-control" required /></div><button class="btn btn-outline-primary">Grant</button></form></div></div>
<div class="card mb-3"><div class="card-header">Limit override</div><div class="card-body"><form asp-action="SetLimit" asp-route-id="@r.Id" method="post"><div class="mb-2"><label class="form-label" for="o-dim">Limit</label><select id="o-dim" name="Dimension" class="form-select">@foreach (var i in DimensionCatalog.All) { <option value="@i.Dimension">@i.Label (@i.Unit)</option> }</select></div><div class="row g-2 mb-2"><div class="col"><label class="form-label" for="o-val">Value</label><input id="o-val" name="Value" type="number" min="0" class="form-control" /></div><div class="col"><label class="form-label" for="o-exp">Expires</label><input id="o-exp" name="ExpiresAt" type="date" class="form-control" /></div></div><div class="form-check mb-2"><input id="o-unl" name="Unlimited" type="checkbox" value="true" class="form-check-input" /><label class="form-check-label" for="o-unl">Unlimited</label></div><div class="mb-2"><label class="form-label" for="o-reason">Reason (audited)</label><input id="o-reason" name="Reason" class="form-control" required /></div><button class="btn btn-outline-primary">Save override</button></form></div></div>
<div class="card mb-3"><div class="card-header">Feature override</div><div class="card-body"><form asp-action="SetFeature" asp-route-id="@r.Id" method="post"><div class="mb-2"><select name="Feature" class="form-select" aria-label="Feature">@foreach (var f in Features.All) { <option value="@f.Key">@f.Label</option> }</select></div><div class="form-check mb-2"><input id="f-on" name="Enabled" type="checkbox" value="true" class="form-check-input" checked /><label class="form-check-label" for="f-on">Enabled</label></div><div class="mb-2"><input name="Reason" class="form-control" placeholder="Reason (audited)" required /></div><button class="btn btn-outline-primary">Save</button></form></div></div>
@if (r.Status == TenantStatus.Active) { <div class="card border-danger"><div class="card-header">Suspend</div><div class="card-body"><form asp-action="Suspend" asp-route-id="@r.Id" method="post"><div class="mb-2"><select name="Kind" class="form-select" aria-label="Kind"><option value="Manual">Manual</option><option value="NonPayment">Non-payment</option><option value="Abuse">Abuse</option></select></div><div class="mb-2"><input name="Reason" class="form-control" placeholder="Reason" required /></div><button class="btn btn-danger">Suspend tenant</button></form></div></div> }
</div></div>
<h2 class="h5 mt-4">Invoices</h2>
<div class="card"><div class="table-responsive"><table class="table mb-0"><thead><tr><th>Number</th><th>Status</th><th class="text-end">Total</th><th></th></tr></thead><tbody>@foreach (var i in d.Invoices) { <tr><td>@i.Number</td><td>@i.Status</td><td class="text-end">@BillingFormat.Money(i.Total, i.Currency)</td><td class="text-end"><a class="btn btn-outline-primary btn-sm" asp-controller="PlatformPayments" asp-action="Invoice" asp-route-forTenant="@r.Id" asp-route-id="@i.Id">Open</a></td></tr> }</tbody></table></div></div>
