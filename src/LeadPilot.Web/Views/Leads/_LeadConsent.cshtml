@model LeadDetailsViewModel
@using LeadPilot.Domain.Crm
@{ var h = Model.ConsentHistory!; var can = Model.Can; }
<div class="alert alert-info small">Consent records are <strong>append-only</strong>: they can never be edited or deleted. To withdraw consent, record a revocation. A contact can only be messaged when consent is granted for the channel and purpose, the value is not on the suppression list, and the contact is valid.</div>
@if (can.Consent && Model.Contacts.Count > 0)
{
    <form asp-action="RecordConsent" asp-route-id="@Model.Lead.Id" method="post" data-loading-form novalidate class="card card-body mb-3">
        <h2 class="h6">Record consent</h2>
        <div class="row g-3">
            <div class="col-12 col-md-6 col-xl-3"><label asp-for="ConsentForm.ContactId" class="form-label"></label>
                <select asp-for="ConsentForm.ContactId" class="form-select">@foreach (var c in Model.Contacts) { <option value="@c.Id">@(c.Name ?? c.Phone ?? c.Email)</option> }</select></div>
            <div class="col-12 col-md-6 col-xl-3"><label asp-for="ConsentForm.Channel" class="form-label"></label><select asp-for="ConsentForm.Channel" class="form-select" asp-items="Html.GetEnumSelectList<ConsentChannel>()"></select></div>
            <div class="col-12 col-md-6 col-xl-3"><label asp-for="ConsentForm.Purpose" class="form-label"></label><select asp-for="ConsentForm.Purpose" class="form-select" asp-items="Html.GetEnumSelectList<ConsentPurpose>()"></select></div>
            <div class="col-12 col-md-6 col-xl-3"><label asp-for="ConsentForm.Status" class="form-label"></label><select asp-for="ConsentForm.Status" class="form-select" asp-items="Html.GetEnumSelectList<ConsentStatus>()"></select></div>
            <div class="col-12 col-md-6 col-xl-3"><label asp-for="ConsentForm.Source" class="form-label"></label><input asp-for="ConsentForm.Source" class="form-control" placeholder="e.g. web form, verbal at fair, STOP reply" required /></div>
            <div class="col-12 col-md-6 col-xl-3"><label asp-for="ConsentForm.EvidenceRef" class="form-label"></label><input asp-for="ConsentForm.EvidenceRef" class="form-control" placeholder="form submission id, recording id…" /></div>
            <div class="col-12 col-md-6 col-xl-3"><label asp-for="ConsentForm.OccurredAtUtc" class="form-label"></label><input asp-for="ConsentForm.OccurredAtUtc" type="datetime-local" class="form-control" /></div>
            <div class="col-12 col-md-6 col-xl-3"><label asp-for="ConsentForm.Note" class="form-label"></label><input asp-for="ConsentForm.Note" class="form-control" /></div>
        </div>
        <div class="mt-3"><button type="submit" class="btn btn-primary"><span class="spinner-border spinner-border-sm d-none" aria-hidden="true"></span> Record</button></div>
    </form>
}
@if (h.Items.Count == 0)
{
    <div class="card"><partial name="_EmptyState" model='("No consent recorded", "Until consent is recorded for a channel and purpose, the contacts of this lead cannot be added to a campaign audience.")' /></div>
}
else
{
    <div class="card"><div class="table-responsive"><table class="table align-middle mb-0">
        <thead><tr><th>When (UTC)</th><th>Contact</th><th>Channel / purpose</th><th>Decision</th><th>Source</th><th>Evidence</th><th>Recorded by</th></tr></thead>
        <tbody>
        @foreach (var r in h.Items)
        {
            <tr>
                <td class="text-nowrap">@r.OccurredAtUtc.ToString("yyyy-MM-dd HH:mm")</td><td>@r.ContactName</td><td>@r.Channel / @r.Purpose</td>
                <td><span class="badge @(r.Status == ConsentStatus.Granted ? "text-bg-success" : "text-bg-danger")">@r.Status</span></td>
                <td>@r.Source @if (r.Note is not null) { <div class="small text-muted">@r.Note</div> }</td><td>@(r.EvidenceRef ?? "—")</td><td>@(r.RecordedByName ?? "system")</td>
            </tr>
        }
        </tbody></table></div></div>
    <partial name="_Pager" model='new PagerModel(h.Page, h.TotalPages, h.TotalCount, "Details", new Dictionary<string, string?> { ["id"] = Model.Lead.Id.ToString(), ["tab"] = "consent" })' />
}
