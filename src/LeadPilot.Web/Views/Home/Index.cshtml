@{
    ViewData["Title"] = "Dashboard";
    var dbOk = (bool)ViewBag.DatabaseHealthy;
}
<div class="d-flex flex-wrap justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Dashboard</h1>
</div>

<div class="row g-3">
    <div class="col-12 col-xl-8">
        <div class="card h-100">
            <div class="card-header">Business metrics</div>
            <div class="card-body">
                <partial name="_EmptyState" model='("No data yet", "Lead, campaign and conversation metrics appear here once those modules are available. Nothing on this page is sample data.")' />
            </div>
        </div>
    </div>
    <div class="col-12 col-md-6 col-xl-4">
        <div class="card h-100">
            <div class="card-header">System status</div>
            <ul class="list-group list-group-flush">
                <li class="list-group-item d-flex justify-content-between"><span>Database</span>
                    <span class="badge @(dbOk ? "text-bg-success" : "text-bg-danger")">@(dbOk ? "Connected" : "Unavailable")</span></li>
                <li class="list-group-item d-flex justify-content-between"><span>Environment</span><span>@ViewBag.Environment</span></li>
                <li class="list-group-item d-flex justify-content-between"><span>Version</span><span>@ViewBag.Version</span></li>
            </ul>
        </div>
    </div>
</div>
