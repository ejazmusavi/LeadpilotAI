@model UserEditViewModel
@{ ViewData["Title"] = Model.Member.DisplayName; }
<h1 class="h3 mb-1">@Model.Member.DisplayName</h1>
<p class="text-muted">@Model.Member.Email</p>
<form asp-action="Edit" asp-route-id="@Model.Member.UserId" method="post" data-loading-form class="card card-body">
    <h2 class="h6">Roles in this workspace</h2>
    <div class="row g-3">
        @foreach (var r in Model.Roles)
        {
            <div class="col-12 col-md-6 col-xl-3">
                <div class="form-check"><input class="form-check-input" type="checkbox" name="selectedRoleIds" value="@r.Id" id="r-@r.Id" checked="@Model.SelectedRoleIds.Contains(r.Id)" />
                    <label class="form-check-label" for="r-@r.Id">@r.Name @if (r.IsSystem) { <span class="badge text-bg-light">system</span> }</label>
                    <div class="text-muted small">@r.Description</div></div>
            </div>
        }
    </div>
    <div class="form-text mt-3">You can only grant or remove roles whose permissions you hold yourself.</div>
    <div class="mt-3 d-flex gap-2"><button type="submit" class="btn btn-primary"><span class="spinner-border spinner-border-sm d-none" aria-hidden="true"></span> Save roles</button><a asp-action="Index" class="btn btn-outline-secondary">Cancel</a></div>
</form>
