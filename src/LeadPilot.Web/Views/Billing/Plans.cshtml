@model PlansViewModel
@using LeadPilot.Web.Models
@using LeadPilot.Application.Billing
@{ ViewData["Title"] = "Change plan"; }
<h1 class="h3 mb-2">Change plan</h1>
<p class="text-muted">Upgrades take effect when their invoice is verified as paid (unused time on a paid period is credited). Downgrades are scheduled for the end of the period and are refused while your usage is above the new plan.</p>
@if (Model.OpenChange is { } oc) { <div class="alert alert-info">There is an open plan change (@oc.Kind to @oc.ToPlanName, @oc.Status). @if (Model.CanManage) { <form asp-action="CancelChange" asp-route-id="@oc.Id" method="post" class="d-inline"><button class="btn btn-link p-0">Cancel it</button></form> }</div> }
@if (Model.Plans.Count == 0) { <div class="card"><partial name="_EmptyState" model='("No plans are available", "The platform owner has not published any plan yet.")' /></div> }
<div class="row g-3">
@foreach (var p in Model.Plans)
{
    var current = Model.Current?.PlanId == p.Id;
    <div class="col-md-6 col-xl-4"><div class="card h-100 @(current ? "border-primary" : "")" data-plan="@p.Code"><div class="card-body">
        <h2 class="h5">@p.Name @if (current) { <span class="badge bg-primary">Current</span> }</h2>
        <div class="h4">@(p.Price == 0 ? "Free" : BillingFormat.Money(p.Price, p.Currency)) <span class="small text-muted">/ @p.Cycle.ToString().ToLowerInvariant()</span></div>
        @if (!string.IsNullOrWhiteSpace(p.Description)) { <p class="small text-muted">@p.Description</p> }
        <ul class="small ps-3">
        @foreach (var d in DimensionCatalog.All) { var has = p.Limits.TryGetValue(d.Dimension, out var v); <li>@d.Label: <strong>@(!has || v is null ? "Unlimited" : v == 0 ? "Not included" : BillingFormat.Amount(v.Value, d.UiFactor, d.Unit))</strong></li> }
        </ul>
        <div class="small mb-2">@string.Join(", ", p.Features.Select(f => Features.All.FirstOrDefault(x => x.Key == f)?.Label ?? f))</div>
        @if (Model.CanManage && !current && Model.OpenChange is null) { <a class="btn btn-outline-primary" asp-action="Preview" asp-route-planId="@p.Id">Review change</a> }
    </div></div></div>
}
</div>
