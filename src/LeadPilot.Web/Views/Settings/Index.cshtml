@model SettingsViewModel
@{ ViewData["Title"] = "Settings"; }
<h1 class="h3 mb-3">Settings</h1>
<form asp-action="Profile" method="post" data-loading-form novalidate class="card card-body mb-4">
    <h2 class="h6 mb-3">Workspace profile</h2>
    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
    <div class="row g-3">
        <div class="col-12 col-md-6 col-xl-3"><label asp-for="Profile.Name" class="form-label">Name</label><input asp-for="Profile.Name" class="form-control" /><span asp-validation-for="Profile.Name" class="text-danger small"></span></div>
        <div class="col-12 col-md-6 col-xl-3"><label asp-for="Profile.Industry" class="form-label">Industry</label><input asp-for="Profile.Industry" class="form-control" /></div>
        <div class="col-12 col-md-6 col-xl-3"><label asp-for="Profile.Timezone" class="form-label">Timezone</label><input asp-for="Profile.Timezone" class="form-control" /></div>
        <div class="col-12 col-md-6 col-xl-3"><label asp-for="Profile.Locale" class="form-label">Locale</label><input asp-for="Profile.Locale" class="form-control" /></div>
    </div>
    <div class="mt-3"><button type="submit" class="btn btn-primary"><span class="spinner-border spinner-border-sm d-none" aria-hidden="true"></span> Save profile</button></div>
</form>

<form asp-action="Save" method="post" data-loading-form novalidate class="card card-body mb-4">
    <h2 class="h6 mb-3">Add or change a setting</h2>
    <div class="row g-3">
        <div class="col-12 col-md-6 col-xl-3"><label asp-for="NewSetting.Key" class="form-label">Key</label><input asp-for="NewSetting.Key" class="form-control" /><span asp-validation-for="NewSetting.Key" class="text-danger small"></span></div>
        <div class="col-12 col-md-6 col-xl-6"><label asp-for="NewSetting.Value" class="form-label">Value</label><input asp-for="NewSetting.Value" class="form-control" autocomplete="off" /><span asp-validation-for="NewSetting.Value" class="text-danger small"></span></div>
        <div class="col-12 col-md-6 col-xl-3 d-flex align-items-end"><div class="form-check"><input asp-for="NewSetting.IsSecret" class="form-check-input" /><label asp-for="NewSetting.IsSecret" class="form-check-label">Secret</label></div></div>
    </div>
    <div class="form-text mt-2">Saving an existing key replaces its value. Secret values are encrypted and never shown again.</div>
    <div class="mt-3"><button type="submit" class="btn btn-primary"><span class="spinner-border spinner-border-sm d-none" aria-hidden="true"></span> Save setting</button></div>
</form>

@if (Model.Settings.Count == 0)
{
    <div class="card"><partial name="_EmptyState" model='("No settings yet", "Workspace-specific key/value settings you add appear here.")' /></div>
}
else
{
    <div class="card"><div class="table-responsive"><table class="table align-middle mb-0">
        <thead><tr><th>Key</th><th>Value</th><th>Updated</th><th></th></tr></thead>
        <tbody>
        @foreach (var s in Model.Settings)
        {
            <tr><td><code>@s.Key</code></td><td>@s.Value @if (s.IsSecret) { <span class="badge text-bg-warning">secret</span> }</td><td>@s.UpdatedAtUtc?.ToString("yyyy-MM-dd HH:mm")</td>
                <td class="text-end"><form asp-action="Delete" method="post"><input type="hidden" name="key" value="@s.Key" /><button type="submit" class="btn btn-sm btn-outline-danger" data-confirm="Delete the setting '@s.Key'?" data-confirm-label="Delete">Delete</button></form></td></tr>
        }
        </tbody></table></div></div>
}
