@model LeadPilot.Application.Billing.InvoiceDto
@using LeadPilot.Web.Models
<div class="card" data-invoice="@Model.Number"><div class="card-body">
<div class="row g-3 mb-3"><div class="col-md-6"><div class="text-muted small">From</div><div style="white-space:pre-line">@(Model.SellerText ?? "LeadPilot AI")</div></div>
<div class="col-md-6 text-md-end"><div class="text-muted small">Billed to</div><div>@Model.BillToName</div><div class="small text-muted">Issued @Model.IssuedAtUtc?.ToString("yyyy-MM-dd") · Due @Model.DueAtUtc?.ToString("yyyy-MM-dd")</div>@if (Model.PaidAtUtc is not null) { <div class="small text-success">Paid @Model.PaidAtUtc.Value.ToString("yyyy-MM-dd")</div> }@if (Model.VoidedAtUtc is not null) { <div class="small text-danger">Void: @Model.VoidReason</div> }</div></div>
<div class="table-responsive"><table class="table"><thead><tr><th>Description</th><th class="text-end">Qty</th><th class="text-end">Unit price</th><th class="text-end">Amount</th></tr></thead><tbody>
@foreach (var l in Model.Lines) { <tr><td>@l.Description</td><td class="text-end">@l.Quantity.ToString("0.##")</td><td class="text-end">@BillingFormat.Money(l.UnitPrice, Model.Currency)</td><td class="text-end">@BillingFormat.Money(l.Amount, Model.Currency)</td></tr> }
</tbody><tfoot><tr><td colspan="3" class="text-end">Subtotal</td><td class="text-end">@BillingFormat.Money(Model.Subtotal, Model.Currency)</td></tr>
@if (Model.TaxRatePercent > 0) { <tr><td colspan="3" class="text-end">@(Model.TaxName ?? "Tax") (@Model.TaxRatePercent.ToString("0.##")%)</td><td class="text-end">@BillingFormat.Money(Model.TaxAmount, Model.Currency)</td></tr> }
<tr class="fw-bold"><td colspan="3" class="text-end">Total</td><td class="text-end">@BillingFormat.Money(Model.Total, Model.Currency)</td></tr></tfoot></table></div>
<div class="small text-muted">Service period @Model.PeriodStartUtc.ToString("yyyy-MM-dd") → @Model.PeriodEndUtc.ToString("yyyy-MM-dd") (UTC) · Plan: @Model.PlanName</div>
@if (!string.IsNullOrWhiteSpace(Model.PaymentInstructions)) { <div class="mt-3"><div class="text-muted small">How to pay</div><div style="white-space:pre-line">@Model.PaymentInstructions</div><div class="small text-muted">Quote <strong>@Model.Number</strong> as the payment reference.</div></div> }
</div></div>
