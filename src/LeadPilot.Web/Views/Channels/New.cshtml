@model AccountFormModel
@{ ViewData["Title"] = "Add WhatsApp account"; }
<h1 class="h3 mb-3">Add a WhatsApp account</h1>
<partial name="_WhatsAppRisk" />
<div class="row"><div class="col-12 col-lg-8">
<form method="post" data-loading-form novalidate class="card card-body">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="row g-3">
        <div class="col-12"><label asp-for="DisplayName" class="form-label">Account name</label><input asp-for="DisplayName" class="form-control" placeholder="Sales line" required /><span asp-validation-for="DisplayName" class="text-danger"></span></div>
        <div class="col-12"><label asp-for="BaseUrl" class="form-label"></label><input asp-for="BaseUrl" class="form-control" placeholder="https://waha.example.com" required /><div class="form-text">The address of your own WAHA server, reachable from this server. Credentials are encrypted before they are stored.</div><span asp-validation-for="BaseUrl" class="text-danger"></span></div>
        <div class="col-12 col-md-6"><label asp-for="ApiKey" class="form-label"></label><input asp-for="ApiKey" class="form-control" type="password" autocomplete="off" required /><div class="form-text">The value of <code>WAHA_API_KEY</code> (sent as <code>X-Api-Key</code>).</div><span asp-validation-for="ApiKey" class="text-danger"></span></div>
        <div class="col-12 col-md-6"><label asp-for="SessionName" class="form-label"></label><input asp-for="SessionName" class="form-control" placeholder="my-company-sales" required /><div class="form-text">Created in WAHA if it does not exist. Must be unique across LeadPilot.</div><span asp-validation-for="SessionName" class="text-danger"></span></div>
        <div class="col-12"><label asp-for="WebhookSecret" class="form-label">Webhook secret (optional)</label><input asp-for="WebhookSecret" class="form-control" type="password" autocomplete="off" /><div class="form-text">Used to sign events (HMAC-SHA512). Leave empty and one is generated and registered with WAHA when you connect.</div></div>
        <div class="col-12"><h2 class="h6 mt-2">Sending limits</h2><div class="form-text mb-2">Conservative defaults. A new number also warms up: 20 messages on its first day, 20 more each day, up to the daily cap.</div></div>
        <div class="col-12 col-md-4"><label asp-for="HourlyCap" class="form-label"></label><input asp-for="HourlyCap" class="form-control" type="number" min="1" max="120" /></div>
        <div class="col-12 col-md-4"><label asp-for="DailyCap" class="form-label"></label><input asp-for="DailyCap" class="form-control" type="number" min="1" max="1000" /></div>
        <div class="col-12 col-md-4"><label asp-for="MinDelaySeconds" class="form-label"></label><input asp-for="MinDelaySeconds" class="form-control" type="number" min="10" max="3600" /></div>
    </div>
    <div class="mt-3 d-flex flex-wrap gap-2">
        <button type="submit" asp-action="Test" formnovalidate class="btn btn-outline-primary">Test connection</button>
        <button type="submit" asp-action="Create" class="btn btn-primary"><span class="spinner-border spinner-border-sm d-none" aria-hidden="true"></span> Add account</button>
        <a asp-action="Index" class="btn btn-link">Cancel</a>
    </div>
</form></div></div>
