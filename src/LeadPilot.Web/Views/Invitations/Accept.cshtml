@model AcceptInvitationViewModel
@{ Layout = "_AuthLayout"; ViewData["Title"] = "Accept invitation"; var p = Model.Preview!; }
<h2 class="h5">Join @p.TenantName</h2>
<p class="text-muted">You were invited as <strong>@p.RoleName</strong> using <strong>@p.Email</strong>.</p>
<form asp-action="Accept" method="post" data-loading-form novalidate>
    <input type="hidden" asp-for="Token" />
    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
    @if (p.AccountExists && Model.SignedInAsInvitee)
    {
        <p>You are signed in as this account. Accept to join the workspace.</p>
        <button type="submit" class="btn btn-primary w-100">Accept invitation</button>
    }
    else if (p.AccountExists)
    {
        <p>An account for this e-mail already exists. Sign in with it, then open this link again.</p>
        <a class="btn btn-primary w-100" asp-controller="Account" asp-action="Login" asp-route-returnUrl="@($"/Invitations/Accept?token={Uri.EscapeDataString(Model.Token)}")">Sign in</a>
    }
    else
    {
        <div class="mb-3"><label asp-for="DisplayName" class="form-label"></label><input asp-for="DisplayName" class="form-control" autocomplete="name" required /><span asp-validation-for="DisplayName" class="text-danger small"></span></div>
        <div class="mb-3"><label asp-for="Password" class="form-label">Password</label><input asp-for="Password" class="form-control" autocomplete="new-password" required /><div class="form-text">At least 10 characters with upper, lower case, a digit and a symbol.</div></div>
        <div class="mb-3"><label asp-for="ConfirmPassword" class="form-label"></label><input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" required /><span asp-validation-for="ConfirmPassword" class="text-danger small"></span></div>
        <button type="submit" class="btn btn-primary w-100"><span class="spinner-border spinner-border-sm d-none" aria-hidden="true"></span> Create account and join</button>
    }
</form>
